### Variables
@baseUrl = http://localhost:3000
@contentType = application/json

# The basic request
{{baseUrl}}

### Get all antique items
GET {{baseUrl}}/antique-items

### Get item by id
GET {{baseUrl}}/antique-items/{{itemId}}


### Create another antique item
# @name createItem
POST {{baseUrl}}/antique-items
Content-Type: {{contentType}}

{
   "name": "Napoleon's Ivory Dueling Pistol",
   "origin": "France",
   "year": 1798,
   "priceEur": 74000,
   "description": "A matched pair ivory-handled flintlock pistol carried during the Egyptian campaign, engraved with the imperial eagle.",
   "createdById": "c5f4f507-52fe-4f2a-8af9-981cc02fa193",
   "categoryId": "2bddded7-7868-40e8-99cb-1ac0a51132fb"
}

### Set the item id
@itemId = {{ createItem.response.body.id }}

### Update antique item
PATCH {{baseUrl}}/antique-items/{{itemId}}
Content-Type: {{contentType}}

{
   "name": "Bedroom Mirror Fancy",
   "origin": "Italy",
   "year": 1892,
   "priceEur": 1499
}

### Update antique item year
PATCH {{baseUrl}}/antique-items/{{itemId}}
Content-Type: {{contentType}}

{  
   "year": 1799
}

### Delete item
DELETE {{baseUrl}}/antique-items/{{itemId}}

### Categories

### Get all categories
GET {{baseUrl}}/categories

### Create another category
POST {{baseUrl}}/categories
Content-Type: {{contentType}}

{
   "name": "Books"
}

### Update category
PATCH {{baseUrl}}/categories/6c87d20a-19a2-43b2-86f5-1648d2aa2299
Content-Type: {{contentType}}

{
   "name": "Books and old stuff"
}

### Delete category
DELETE {{baseUrl}}/categories/6c87d20a-19a2-43b2-86f5-1648d2aa2299