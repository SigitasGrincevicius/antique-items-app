### Variables
@baseUrl = http://localhost:3000
@contentType = application/json

# User IDs
@userId = c5f4f507-52fe-4f2a-8af9-981cc02fa193

# Category IDs
@booksCategoryId = 6f04c0aa-795d-4fe7-883e-778de8123d00
@furnitureCategoryId = 8c832c33-9957-41e8-b887-131279bf182b

# Dynamic IDs (set by requests)
@itemId =
@createdCategoryId =

########################################
# USER ENDPOINTS
########################################

### Create user (Skywalker)
# @name createUser
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
   "name": "Skywalker",
   "email": "jedi@sw.com",
   "password": "TatooineSky#2026"
}

### Login
# @name loginUser
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
   "email": "jedi@sw.com",
   "password": "TatooineSky#2026"
}

### Set token from last login
@authToken = {{ loginUser.response.body.accessToken }}

########################################
# ANTIQUE ITEMS ENDPOINTS
########################################

### Get all antique items with pagination
# @name getAllItems
GET {{baseUrl}}/antique-items?limit=10&page=1&sortOrder=ASC&sortBy=name
Authorization: Bearer {{authToken}}


### Get antique items by category
# @name getItemsByCategory
GET {{baseUrl}}/antique-items?categoryId={{booksCategoryId}}
Authorization: Bearer {{authToken}}

### Get all antique items by category
# @name getAllWithSearch
GET {{baseUrl}}/antique-items?search=book
Authorization: Bearer {{authToken}}

### Get all filtered
# @name getAllFilteredByCategories
GET {{baseUrl}}/antique-items?categories=Books,Weapons%20%26%20Militaria
Authorization: Bearer {{authToken}}

### Get all sorted
# @name getAllSorted
GET {{baseUrl}}/antique-items?sortBy=category&sortOrder=ASC
Authorization: Bearer {{authToken}}

### Get antique item by ID
GET {{baseUrl}}/antique-items/{{itemId}}
Authorization: Bearer {{authToken}}

### Create antique item (Book of Kells)
# @name createItem
POST {{baseUrl}}/antique-items
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "name": "Bedroom Mirror",
  "origin": "Greece",
  "year": 1800,
  "priceEur": 1200,
  "description": "An early 19th-century Greek bedroom mirror with a hand-carved walnut frame, aged mercury glass, and subtle floral detailing along its upper crest.",
  "categoryId": "{{furnitureCategoryId}}"
}

### Set item ID from last creation
@itemId = {{ createItem.response.body.id }}

### Update antique item (all fields)
PATCH {{baseUrl}}/antique-items/{{itemId}}
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
   "name": "Bedroom Mirror Fancy",
   "origin": "Italy",
   "year": 1892,
   "priceEur": 1499
}

### Update antique item (year only)
PATCH {{baseUrl}}/antique-items/{{itemId}}
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{  
   "year": 1799
}

### Delete antique item
DELETE {{baseUrl}}/antique-items/{{itemId}}
Authorization: Bearer {{authToken}}

########################################
# FAVORITES ENDPOINTS
########################################

### Add item to favorites
POST /antique-items/{{itemId}}/favorite
Authorization: Bearer {{authToken}}

########################################
# CATEGORIES ENDPOINTS
########################################

### Get all categories
GET {{baseUrl}}/categories
Authorization: Bearer {{authToken}}

### Create category (Books)
# @name createCategory
POST {{baseUrl}}/categories
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "name": "Books"
}

### Set category ID from last creation
@createdCategoryId = {{ createCategory.response.body.id }}

### Update category by ID
PATCH {{baseUrl}}/categories/{{createdCategoryId}}
Authorization: Bearer {{authToken}}
Content-Type: {{contentType}}

{
  "name": "Fine Art & Paintings"
}

### Delete category by ID
DELETE {{baseUrl}}/categories/{{createdCategoryId}}
Authorization: Bearer {{authToken}}