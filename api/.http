### Variables
@baseUrl = http://localhost:3000
@contentType = application/json

# The basic request
{{baseUrl}}

### Get all antique items
GET {{baseUrl}}/antique-items

### Get item by id
GET {{baseUrl}}/antique-items/{{itemId}}


### Create another antique item
# @name createItem
POST {{baseUrl}}/antique-items
Content-Type: {{contentType}}

{
   "name": "Napoleon's Ivory Dueling Pistol",
   "origin": "France",
   "year": 1798,
   "priceEur": 74000,
   "description": "A matched pair ivory-handled flintlock pistol carried during the Egyptian campaign, engraved with the imperial eagle."
}

### Set the item id
@itemId = {{ createItem.response.body.id }}

### Update antique item
PATCH {{baseUrl}}/antique-items/{{itemId}}
Content-Type: {{contentType}}

{
   "name": "Bedroom Mirror Fancy",
   "origin": "Italy",
   "year": 1892,
   "priceEur": 1499
}

### Update antique item year
PATCH {{baseUrl}}/antique-items/{{itemId}}
Content-Type: {{contentType}}

{  
   "year": 1799
}

### Delete task
DELETE {{baseUrl}}/antique-items/{{itemId}}