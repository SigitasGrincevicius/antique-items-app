### Variables
@baseUrl = http://localhost:3000
@contentType = application/json

# The basic request
{{baseUrl}}

### Get all antique items
GET {{baseUrl}}/antique-items

### Get item by id
GET {{baseUrl}}/antique-items/{{itemId}}

### Create new antique item
# @name createItem
POST {{baseUrl}}/antique-items
Content-Type: {{contentType}}

{
   "name": "Bedroom Mirror",
   "origin": "Italy",
   "year": 1892,
   "priceEur": 1205
}

### Set the item id
@itemId = {{ createItem.response.body.id }}

### Update antique item
PATCH {{baseUrl}}/antique-items/{{itemId}}
Content-Type: {{contentType}}

{
   "name": "Bedroom Mirror Fancy",
   "origin": "Italy",
   "year": 1892,
   "priceEur": 1499
}

### Delete task
DELETE {{baseUrl}}/antique-items/{{itemId}}